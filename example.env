# An example of what the env file should look like
# MongoDB
USER = MYUSERNAME
PASS = MYPASSWORD
HOST = "mycluster.somecharacters.mongodb.net"
DBNAME = MYDBNAME
DBCOLLECTION = MYDBCOLLECTION
USERCOLLECTION = MYUSERCOLLECTION

# Github OAuth
GITHUB_CLIENT_ID = MYGITHUBCLIENTID
GITHUB_CLIENT_SECRET = MYGITHUBCLIENTSECRET
SESSION_SECRET = MYSESSIONSECRET